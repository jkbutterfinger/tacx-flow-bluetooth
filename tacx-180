#!/usr/bin/env bash
# Startet tacx_180.py im korrekten virtuellen Environment.
# Beispiel:
#   ./tacx-180            # 180 W (Default)
#   ./tacx-180 200        # 200 W
#   ./tacx-180 --list     # nur BLE-Geräte auflisten

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PYTHON="$SCRIPT_DIR/.venv/bin/python"

if [[ ! -x "$VENV_PYTHON" ]]; then
    echo "FEHLER: Virtuelles Environment nicht gefunden unter $VENV_PYTHON" >&2
    echo "Bitte erst: python3 -m venv .venv && .venv/bin/pip install bleak" >&2
    exit 1
fi

exec "$VENV_PYTHON" "$SCRIPT_DIR/tacx_180.py" "$@"
