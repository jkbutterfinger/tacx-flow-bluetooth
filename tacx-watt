#!/usr/bin/env bash
# Startet tacx_watt.py im korrekten virtuellen Environment.
# Beispiel:
#   ./tacx-watt                 # live Watt + Tempo anzeigen
#   ./tacx-watt --list          # BLE-Geräte auflisten
#   ./tacx-watt --address AA:BB:CC:DD:EE:FF
#   ./tacx-watt --start         # FTMS-Session starten

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PYTHON="$SCRIPT_DIR/.venv/bin/python"

if [[ ! -x "$VENV_PYTHON" ]]; then
    echo "FEHLER: Virtuelles Environment nicht gefunden unter $VENV_PYTHON" >&2
    echo "Bitte erst: python3 -m venv .venv && .venv/bin/pip install bleak" >&2
    exit 1
fi

exec "$VENV_PYTHON" "$SCRIPT_DIR/tacx_watt.py" "$@"
